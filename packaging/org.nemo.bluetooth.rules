// /etc/polkit-1/rules.d/org.nemo.bluetooth.rules
//
// PolicyKit JavaScript rule — BlueZ Bluetooth Agent
//
// Grants members of the 'bluetooth' system group permission to register
// as the default Bluetooth agent (org.bluez.request-default-agent)
// WITHOUT an authentication prompt.
//
// This is required for NemoHeadUnit to register its RFCOMM pairing agent
// via BlueZ over D-Bus without triggering a polkit password dialog.
//
// Install:
//   sudo cp org.nemo.bluetooth.rules /etc/polkit-1/rules.d/
//   (polkitd picks up .rules files automatically — no restart needed)
//
// To add the application user to the bluetooth group:
//   sudo usermod -aG bluetooth <username>
//   (user must log out and back in)
//
// Note: this file uses the polkit JS rules API (polkit >= 0.106),
// available on all Debian/Ubuntu releases supported by NemoHeadUnit.

polkit.addRule(function(action, subject) {
    if (action.id === "org.bluez.request-default-agent" &&
        subject.isInGroup("bluetooth")) {
        return polkit.Result.YES;
    }
});
