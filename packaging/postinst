#!/bin/bash
# packaging/postinst
#
# dpkg/pacman post-installation script for nemo-headunit.
# Supports both:
#   - venv + uv mode (when packaging/requirements.txt is present)
#   - micromamba mode (when packaging/environment.yml is present)
# Called automatically after all package files are unpacked.

set -euo pipefail

APP_DIR="/opt/nemo-headunit"
ENV_PREFIX="${APP_DIR}/env"
REQUIREMENTS_TXT="${APP_DIR}/requirements.txt"
ENV_YML="${APP_DIR}/environment.yml"

BOOTSTRAP_UV="${APP_DIR}/bootstrap_uv.sh"
UV_BIN_OPT="/opt/uv/bin/uv"

BOOTSTRAP_MICROMAMBA="${APP_DIR}/bootstrap_micromamba.sh"
MICROMAMBA_BIN="/opt/micromamba/micromamba"

SERVICE_NAME="org.nemo.APManager.service"
GROUP_NAME="ap_manager"
BLUETOOTH_GROUP_NAME="bluetooth"
HW_FIX_RUNNER="${APP_DIR}/hardware_fixes/run_hardware_fixes.sh"
LAUNCHER_SRC="${APP_DIR}/bin/nemo-headunit"
LAUNCHER_LINK="/usr/local/bin/nemo-headunit"
DESKTOP_SRC="/usr/share/applications/nemo-headunit.desktop"

log() { echo "[nemo-headunit postinst] $*"; }

find_uv() {
    if command -v uv &>/dev/null; then
        command -v uv
        return 0
    fi
    if [ -x "${UV_BIN_OPT}" ]; then
        echo "${UV_BIN_OPT}"
        return 0
    fi
    if [ -x "/opt/uv/uv" ]; then
        echo "/opt/uv/uv"
        return 0
    fi
    if [ -x "${HOME:-/root}/.local/bin/uv" ]; then
        echo "${HOME:-/root}/.local/bin/uv"
        return 0
    fi
    return 1
}

find_micromamba() {
    if command -v micromamba &>/dev/null; then
        command -v micromamba
        return 0
    fi
    if [ -x "${MICROMAMBA_BIN}" ]; then
        echo "${MICROMAMBA_BIN}"
        return 0
    fi
    return 1
}

run_postinst() {
    # ------------------------------------------------------------------
    # 1. Create system groups and add standard human users automatically
    # ------------------------------------------------------------------
    if ! getent group "${GROUP_NAME}" &>/dev/null; then
        log "Creating system group '${GROUP_NAME}'"
        groupadd --system "${GROUP_NAME}"
    else
        log "Group '${GROUP_NAME}' already exists — skipped."
    fi

    if ! getent group "${BLUETOOTH_GROUP_NAME}" &>/dev/null; then
        log "Creating system group '${BLUETOOTH_GROUP_NAME}'"
        groupadd --system "${BLUETOOTH_GROUP_NAME}"
    else
        log "Group '${BLUETOOTH_GROUP_NAME}' already exists — skipped."
    fi

    # Automatically add existing standard human users to groups for out-of-the-box D-Bus access
    while IFS=: read -r username _ uid _ _ homedir _; do
        if [ "${uid}" -ge 1000 ] && [ "${uid}" -lt 60000 ]; then
            log "Adding user '${username}' to group '${GROUP_NAME}'"
            usermod -aG "${GROUP_NAME}" "${username}" || true
            log "Adding user '${username}' to group '${BLUETOOTH_GROUP_NAME}'"
            usermod -aG "${BLUETOOTH_GROUP_NAME}" "${username}" || true
        fi
    done < <(getent passwd)

    # ------------------------------------------------------------------
    # 2. Build or Update Runtime Environment (Venv+UV vs Micromamba)
    # ------------------------------------------------------------------
    if [ -f "${REQUIREMENTS_TXT}" ]; then
        log "Packaging mode detected: Python venv + uv"

        # Bootstrap uv if needed
        if ! find_uv &>/dev/null; then
            if [ -f "${BOOTSTRAP_UV}" ]; then
                log "uv non trovato — eseguo bootstrap_uv.sh"
                chmod +x "${BOOTSTRAP_UV}"
                bash "${BOOTSTRAP_UV}"
            else
                log "WARNING: uv non trovato e bootstrap_uv.sh assente."
            fi
        else
            log "uv trovato: $(find_uv)"
        fi

        UV_BIN="$(find_uv || true)"
        CHECKSUM_FILE="${ENV_PREFIX}/.env_spec.sha256"
        CURRENT_HASH="$(sha256sum "${REQUIREMENTS_TXT}" 2>/dev/null | awk '{print $1}')"
        SAVED_HASH=""
        if [ -f "${CHECKSUM_FILE}" ]; then
            SAVED_HASH="$(cat "${CHECKSUM_FILE}" 2>/dev/null || true)"
        fi

        # 1. Create venv with system-site-packages enabled if not exists
        if [ ! -f "${ENV_PREFIX}/bin/python" ]; then
            log "Creating virtualenv with --system-site-packages in ${ENV_PREFIX}..."
            python3 -m venv --system-site-packages "${ENV_PREFIX}"
        fi

        # 2. Install/Sync packages via uv
        if [ -n "${UV_BIN}" ]; then
            if [ -d "${ENV_PREFIX}" ] && [ -n "${CURRENT_HASH}" ] && [ "${CURRENT_HASH}" = "${SAVED_HASH}" ]; then
                log "Venv packages in ${ENV_PREFIX} up-to-date with requirements.txt — skipping install."
            else
                log "Installing/updating Python dependencies with uv pip in ${ENV_PREFIX}..."
                VIRTUAL_ENV="${ENV_PREFIX}" "${UV_BIN}" pip install --python "${ENV_PREFIX}/bin/python" -r "${REQUIREMENTS_TXT}"
                echo "${CURRENT_HASH}" > "${CHECKSUM_FILE}"
                log "Venv packages ready."
            fi
        elif [ -x "${ENV_PREFIX}/bin/pip" ]; then
            log "WARNING: uv not found, falling back to standard pip inside venv..."
            "${ENV_PREFIX}/bin/pip" install -r "${REQUIREMENTS_TXT}"
            echo "${CURRENT_HASH}" > "${CHECKSUM_FILE}"
        else
            log "WARNING: neither uv nor pip available to populate venv in ${ENV_PREFIX}."
        fi

    elif [ -f "${ENV_YML}" ]; then
        log "Packaging mode detected: Micromamba"

        if ! find_micromamba &>/dev/null; then
            if [ -f "${BOOTSTRAP_MICROMAMBA}" ]; then
                log "micromamba non trovato — eseguo bootstrap_micromamba.sh"
                chmod +x "${BOOTSTRAP_MICROMAMBA}"
                bash "${BOOTSTRAP_MICROMAMBA}"
            else
                log "WARNING: micromamba non trovato e bootstrap_micromamba.sh assente."
            fi
        else
            log "micromamba trovato: $(find_micromamba)"
        fi

        MM_BIN="$(find_micromamba || true)"
        if [ -n "${MM_BIN}" ]; then
            CHECKSUM_FILE="${ENV_PREFIX}/.env_spec.sha256"
            CURRENT_HASH="$(sha256sum "${ENV_YML}" 2>/dev/null | awk '{print $1}')"
            SAVED_HASH=""
            if [ -f "${CHECKSUM_FILE}" ]; then
                SAVED_HASH="$(cat "${CHECKSUM_FILE}" 2>/dev/null || true)"
            fi

            if [ -d "${ENV_PREFIX}" ] && [ -n "${CURRENT_HASH}" ] && [ "${CURRENT_HASH}" = "${SAVED_HASH}" ]; then
                log "Micromamba env in ${ENV_PREFIX} is up-to-date with environment.yml — skipping update."
            elif [ -d "${ENV_PREFIX}" ]; then
                log "Micromamba env spec changed — updating env in ${ENV_PREFIX}"
                "${MM_BIN}" env update -y -p "${ENV_PREFIX}" -f "${ENV_YML}" --prune
                echo "${CURRENT_HASH}" > "${CHECKSUM_FILE}"
            else
                log "Creazione Micromamba env in ${ENV_PREFIX} (potrebbe richiedere qualche minuto)"
                "${MM_BIN}" create -y -p "${ENV_PREFIX}" -f "${ENV_YML}"
                echo "${CURRENT_HASH}" > "${CHECKSUM_FILE}"
            fi
            log "Micromamba env pronto."
        fi
    fi

    # ------------------------------------------------------------------
    # 2b. Pre-compile Python bytecode to eliminate first-run compilation lag
    # ------------------------------------------------------------------
    log "Pre-compiling Python bytecode (.pyc) for fast startup..."
    local py_compiler="python3"
    if [ -x "${ENV_PREFIX}/bin/python" ]; then
        py_compiler="${ENV_PREFIX}/bin/python"
    fi
    "${py_compiler}" -m compileall -q -f "${APP_DIR}/backend" "${APP_DIR}/services" "${APP_DIR}/protos" 2>/dev/null || true

    # ------------------------------------------------------------------
    # 3. Fix permissions on the installed app directory
    # ------------------------------------------------------------------
    log "Setting permissions on ${APP_DIR}"
    chown -R root:root "${APP_DIR}"
    chmod -R a+rX,u+w "${APP_DIR}"
    mkdir -p "${APP_DIR}/config"
    chmod -R a+rwX,u+w "${APP_DIR}/config"
    if [ -x "${ENV_PREFIX}/bin/python" ]; then
        chmod +x "${ENV_PREFIX}/bin/python"
    fi

    # ------------------------------------------------------------------
    # 4. Fix permissions on privileged service script
    # ------------------------------------------------------------------
    if [ -f "${APP_DIR}/services/linux/ap_manager_service/ap_manager_service.py" ]; then
        chmod 700 "${APP_DIR}/services/linux/ap_manager_service/ap_manager_service.py"
    fi

    # ------------------------------------------------------------------
    # 5. Reload D-Bus so it picks up the new policy
    # ------------------------------------------------------------------
    log "Reloading D-Bus configuration"
    systemctl restart polkit 2>/dev/null || true
    systemctl reload dbus 2>/dev/null || true
    systemctl try-restart bluetooth 2>/dev/null || true

    # ------------------------------------------------------------------
    # 6. Reload systemd and enable + start the AP manager service
    # ------------------------------------------------------------------
    log "Reloading systemd daemon"
    systemctl daemon-reload

    log "Enabling ${SERVICE_NAME}"
    systemctl enable "${SERVICE_NAME}"

    log "Starting/Restarting ${SERVICE_NAME}"
    systemctl restart "${SERVICE_NAME}" || {
        log "WARNING: service failed to start/restart — check: journalctl -u ${SERVICE_NAME} -n 50"
    }

    # ------------------------------------------------------------------
    # 6b. Configure Compositor Autostart (nemo-kiosk.service) & display.conf
    # ------------------------------------------------------------------
    CONFIG_DIR="/etc/nemo-headunit"
    DISPLAY_CONF="${CONFIG_DIR}/display.conf"
    mkdir -p "${CONFIG_DIR}"

    local autostart_kiosk="true"
    local compositor_pref="auto"

    # Interactive prompt if connected to terminal
    if [ -t 0 ] && [ "${DEBIAN_FRONTEND:-}" != "noninteractive" ]; then
        echo ""
        echo "======================================================================="
        echo " NemoHeadUnit: Display & Compositor Configuration"
        echo "======================================================================="
        read -r -p " Enable automatic kiosk mode on boot (compositor + app without DM)? [Y/n]: " ans_auto || ans_auto="Y"
        case "$ans_auto" in
            [nN][oO]|[nN]) autostart_kiosk="false" ;;
            *) autostart_kiosk="true" ;;
        esac

        if [ "$autostart_kiosk" = "true" ]; then
            echo " Choose compositor preference:"
            echo "   1) auto   (lightest installed: cage -> labwc -> weston -> sway)"
            echo "   2) cage   (ultra-lightweight ~15MB RAM kiosk)"
            echo "   3) labwc  (lightweight ~25MB RAM windowed)"
            echo "   4) weston (reference DRM compositor)"
            echo "   5) sway   (tiling DRM compositor)"
            echo "   6) xorg   (legacy X11)"
            read -r -p " Selection [default: 1]: " comp_choice || comp_choice="1"
            case "$comp_choice" in
                2|cage)   compositor_pref="cage" ;;
                3|labwc)  compositor_pref="labwc" ;;
                4|weston) compositor_pref="weston" ;;
                5|sway)   compositor_pref="sway" ;;
                6|xorg)   compositor_pref="xorg" ;;
                *)        compositor_pref="auto" ;;
            esac
        fi
    fi

    # Write /etc/nemo-headunit/display.conf if missing or update values
    if [ ! -f "${DISPLAY_CONF}" ]; then
        cat <<EOF > "${DISPLAY_CONF}"
# /etc/nemo-headunit/display.conf
# NemoHeadUnit Display & Compositor Configuration

COMPOSITOR_AUTOSTART=${autostart_kiosk}
COMPOSITOR_PREFERENCE="${compositor_pref}"
COMPOSITOR_TTY="7"
QT_SCALE_FACTOR="1.5"
EOF
        chmod 644 "${DISPLAY_CONF}"
        log "Created ${DISPLAY_CONF} (autostart=${autostart_kiosk}, preference=${compositor_pref})"
    fi

    # Install and configure nemo-kiosk.service
    KIOSK_SERVICE_SRC="${APP_DIR}/packaging/nemo-kiosk.service"
    if [ ! -f "${KIOSK_SERVICE_SRC}" ] && [ -f "/usr/lib/systemd/system/nemo-kiosk.service" ]; then
        KIOSK_SERVICE_SRC="/usr/lib/systemd/system/nemo-kiosk.service"
    fi

    if [ -f "${KIOSK_SERVICE_SRC}" ]; then
        cp -f "${KIOSK_SERVICE_SRC}" /etc/systemd/system/nemo-kiosk.service
        # Resolve target user (prefer first human user UID >= 1000)
        local target_user="nemo"
        if [ -n "$(id -un 1000 2>/dev/null)" ]; then
            target_user="$(id -un 1000)"
        fi
        sed -i "s/^User=.*/User=${target_user}/" /etc/systemd/system/nemo-kiosk.service
        sed -i "s/^Group=.*/Group=${target_user}/" /etc/systemd/system/nemo-kiosk.service
        sed -i "s|^WorkingDirectory=.*|WorkingDirectory=/home/${target_user}|" /etc/systemd/system/nemo-kiosk.service
        sed -i "s|XDG_RUNTIME_DIR=/run/user/.*|XDG_RUNTIME_DIR=/run/user/$(id -u "${target_user}")|" /etc/systemd/system/nemo-kiosk.service

        systemctl daemon-reload
        if [ "${autostart_kiosk}" = "true" ]; then
            log "Enabling nemo-kiosk.service for autostart on boot (user: ${target_user})"
            systemctl enable nemo-kiosk.service || true
        else
            log "Disabling nemo-kiosk.service"
            systemctl disable nemo-kiosk.service || true
        fi
    fi

    # ------------------------------------------------------------------
    # 7. Platform-specific hardware fixes
    # ------------------------------------------------------------------
    if [ -f "${HW_FIX_RUNNER}" ]; then
        log "Running platform hardware fixes"
        chmod +x "${HW_FIX_RUNNER}"
        bash "${HW_FIX_RUNNER}" || log "WARNING: hardware fix runner exited with errors — check output above."
    else
        log "No hardware fix runner found at ${HW_FIX_RUNNER} — skipped."
    fi

    # ------------------------------------------------------------------
    # 8. Create /usr/local/bin symlink for CLI access
    # ------------------------------------------------------------------
    if [ -f "${LAUNCHER_SRC}" ]; then
        log "Creating symlink: ${LAUNCHER_LINK} -> ${LAUNCHER_SRC}"
        ln -sf "${LAUNCHER_SRC}" "${LAUNCHER_LINK}"
    else
        log "WARNING: launcher not found at ${LAUNCHER_SRC} — CLI symlink skipped."
    fi

    # ------------------------------------------------------------------
    # 9. Add desktop shortcut to all existing human users' Desktops
    # ------------------------------------------------------------------
    if [ -f "${DESKTOP_SRC}" ]; then
        while IFS=: read -r username _ uid _ _ homedir _; do
            if [ "${uid}" -ge 1000 ] && [ "${uid}" -lt 60000 ] && [ -d "${homedir}/Desktop" ]; then
                DEST="${homedir}/Desktop/nemo-headunit.desktop"
                cp "${DESKTOP_SRC}" "${DEST}"
                chmod +x "${DEST}"
                chown "${username}:${username}" "${DEST}" 2>/dev/null || true
                log "Desktop shortcut created for user '${username}' at ${DEST}"
            fi
        done < <(getent passwd)
    else
        log "WARNING: .desktop file not found at ${DESKTOP_SRC} — desktop shortcut skipped."
    fi

    # Update the application menu database
    if command -v update-desktop-database &>/dev/null; then
        log "Updating desktop database"
        update-desktop-database /usr/share/applications/ 2>/dev/null || true
    fi

    log "Installation complete."
    log "  To add a user to the '${GROUP_NAME}' group:"
    log "    sudo usermod -aG ${GROUP_NAME} <username>"
    log "  To add a user to the '${BLUETOOTH_GROUP_NAME}' group:"
    log "    sudo usermod -aG ${BLUETOOTH_GROUP_NAME} <username>"
}

# Pacman hooks call post_install and post_upgrade as shell functions
post_install() {
    run_postinst
}

post_upgrade() {
    run_postinst
}

# Dpkg hooks invoke the script directly with arguments (configure, upgrade, etc.)
if [ $# -gt 0 ]; then
    case "$1" in
        configure|post_install|post_upgrade|[0-9]*|"")
            run_postinst
            ;;
        upgrade)
            log "Upgrade detected — restarting ${SERVICE_NAME}"
            systemctl restart "${SERVICE_NAME}" || true
            ;;
        abort-upgrade|abort-install|abort-remove)
            log "Aborting installation / upgrade. No cleanup performed."
            ;;
        *)
            log "Unknown argument: $1 — ignoring."
            ;;
    esac
elif [ "${0##*/}" = "postinst" ]; then
    run_postinst
fi

exit 0
