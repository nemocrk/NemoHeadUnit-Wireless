/* NemoHeadUnit-Wireless Qt6 Theme Stylesheet (Replicating Automotive Glassmorphism Design System) */

QMainWindow {
    background-color: #0b0f19;
    color: #f8fafc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #f8fafc;
}

/* ------------------------------------------------------------------
   Command Bar (Floating Bottom Control Bar)
   ------------------------------------------------------------------ */
#command-bar {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 30px;
    padding: 6px 16px;
}

QPushButton.cmd-btn {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 26px;
    min-width: 52px;
    max-width: 52px;
    min-height: 52px;
    max-height: 52px;
}

QPushButton.cmd-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.25);
}

QPushButton.cmd-btn:pressed {
    background-color: rgba(0, 230, 118, 0.3);
}

/* Status Indicator Dot */
#status-dot-online {
    background-color: #00e676;
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
}

#status-dot-offline {
    background-color: #ff5252;
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
}

/* ------------------------------------------------------------------
   Arc Radial Floating Action Button (FAB) Menu
   ------------------------------------------------------------------ */
QPushButton.arc-fab-item {
    background-color: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 26px;
    min-width: 52px;
    max-width: 52px;
    min-height: 52px;
    max-height: 52px;
}

QPushButton.arc-fab-item:hover {
    background-color: #00b0ff;
    border-color: #00e676;
}

/* ------------------------------------------------------------------
   Volume Popover Card
   ------------------------------------------------------------------ */
#volume-popover {
    background-color: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 8px 16px;
}

QPushButton.vol-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    font-weight: bold;
    font-size: 16px;
    color: #f8fafc;
}

QPushButton.vol-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

QLabel#vol-level-display {
    font-size: 14px;
    font-weight: 600;
    color: #f8fafc;
    padding: 0 8px;
}

/* ------------------------------------------------------------------
   Slide-Over Drawers (Bluetooth, Settings, Logs)
   ------------------------------------------------------------------ */
QWidget.drawer-card {
    background-color: rgba(11, 15, 25, 0.95);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
}

QLabel.drawer-title {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
}

QPushButton.close-btn {
    background: transparent;
    border: none;
    font-size: 22px;
    font-weight: bold;
    color: #94a3b8;
}

QPushButton.close-btn:hover {
    color: #ff5252;
}

/* Console Log View */
QTextEdit#log-console {
    background-color: #050811;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #00e676;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
}

QComboBox.styled-select {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 4px 8px;
    color: #f8fafc;
}

QComboBox.styled-select:hover {
    border-color: #00b0ff;
}

QComboBox::drop-down {
    border: none;
}
