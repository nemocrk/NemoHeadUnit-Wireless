{
    "version": "0.2.0", // AGGIUNGI QUESTA RIGA QUI
    "configurations": [
        {
            "name": "Python: Debug Tests",
            "type": "debugpy", // Nelle versioni più vecchie era "python"
            "request": "launch",
            "program": "${file}",
            "purpose": [
                "debug-test"
            ], // QUESTO È IL CAMPO FONDAMENTALE PER I TEST
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Multi Process Version",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "env": {
                "DBUS_SYSTEM_BUS_ADDRESS": "unix:path=/run/dbus/system_bus_socket"
            }
        },
        {
            "name": "Web Browser Version",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/web-browser-head-unit/backend/main.py",
            "cwd": "${workspaceFolder}/web-browser-head-unit/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/web-browser-head-unit/backend"
            },
            "python": "${command:python.interpreterPath}"
        },
        {
            "name": "Explore Protocol",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/shared/proto_explorer.py",
            "args": [
                "${input:pythonClass}"
            ]
        },
        {
            "name": "Collect Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${workspaceFolder}/tests/",
                "--collect-only"
            ]
        },
        {
            "name": "pytest (unit+integration)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "--rootdir=.",
                "-c",
                "pyproject.toml",
                "tests",
                "-m",
                "unit or integration",
                "--cov=.",
                "--cov-config=v2/pyproject.toml",
                "--cov-report=term-missing",
                "--cov-fail-under=80",
                "-v",
                "-s",
                "--tb=long",
                "--log-cli-level=DEBUG"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "pythonClass",
            "type": "promptString",
            "description": "Inserisci il nome della classe:",
            "default": "---"
        }
    ]
}