{
    "version": "0.2.0", // AGGIUNGI QUESTA RIGA QUI
    "configurations": [
        {
            "name": "Python: Debug Tests",
            "type": "debugpy", // Nelle versioni più vecchie era "python"
            "request": "launch",
            "program": "${file}",
            "purpose": [
                "debug-test"
            ], // QUESTO È IL CAMPO FONDAMENTALE PER I TEST
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Standard Version",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/main.py"
        },
        {
            "name": "Multi Process Version",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/v2/main.py"
        },
        {
            "name": "Explore Protocol",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/v2/shared/proto_explorer.py",
            "args": [
                "${input:pythonClass}"
            ]
        },
        {
            "name": "Collect Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${workspaceFolder}/v2/tests/",
                "--collect-only"
            ]
        }
    ],
    "inputs": [
        {
            "id": "pythonClass",
            "type": "promptString",
            "description": "Inserisci il nome della classe:",
            "default": "---"
        }
    ]
}